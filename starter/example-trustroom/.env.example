# Copy to .env and add your key. Apertus runs on CSCS, reached through the Keera gateway
# (OpenAI-compatible). Models: apertus-v1-5-70b, apertus-v1-5-8b and their -thinking variants;
# more information: https://app.sprintd.org/events/hack-apertus-zurich/perks.
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_API_KEY=
LLM_NAME=apertus-v1-5-8b
# The -thinking models are served without tool calls: set this to false for them. The model then
# answers without any tools (no banking API, no MCP), only from the conversation and the context.
LLM_TOOL_CALLS=true
